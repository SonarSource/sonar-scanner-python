{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>SonarSource/renovate-config:languages-team"
  ],
  "enabledManagers": ["pep621", "github-actions", "dockerfile", "mise"],
  "ignorePaths": [
    "its/**",
    "**/test/**"
  ],
  "packageRules": [
    {
      "description": "Enable only major, minor and patch version updates for github-actions and pep621",
      "matchManagers": ["github-actions", "pep621"],
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"],
      "enabled": false
    }
  ]

}
